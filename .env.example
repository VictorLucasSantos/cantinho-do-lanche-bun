# Copie este arquivo para ".env" (sem o ".example") e preencha com seus dados.
# O arquivo .env fica na raiz do projeto (ao lado do package.json).
# NUNCA envie o .env real para o GitHub.

PIX_KEY=sua-chave-pix@exemplo.com
MERCHANT_NAME=CANTINHO DO LANCHE
MERCHANT_CITY=SAO PAULO
ADMIN_TOKEN=troque-por-um-token-forte-aqui
# Opcional: porta do servidor (padrão 8000).
# PORT=8000
# Opcional: interface de rede. Em produção atrás do Caddy, use 127.0.0.1.
# HOST=0.0.0.0
# Opcional: somente se o frontend for servido em outro domínio.
# CORS_ORIGINS=https://seu-dominio.com
# Opcional: caminho do arquivo SQLite. Sem esta variável, usa ./cantinho.db
# DATABASE_PATH=/data/cantinho.db
# Opcional: banco no Turso (obrigatório no Render). Tem prioridade sobre DATABASE_PATH.
# TURSO_DATABASE_URL=libsql://seu-banco-seu-usuario.turso.io
# TURSO_AUTH_TOKEN=cole-o-token-aqui
